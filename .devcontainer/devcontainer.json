{
  "name": "Star Wars API",
  "image": "mcr.microsoft.com/vscode/devcontainers/universal:latest",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.vscode-dotnet-runtime"
      ]
    }
  },
  "forwardPorts": [5150],
  "postCreateCommand": "dotnet restore",
  "portsAttributes": {
    "5150": {
      "label": "Star Wars API",
      "onAutoForward": "notify",
      "visibility": "public"
    }
  }
}
